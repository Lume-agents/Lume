@@ -0,0 +1,41 @@
+//! Fail-open publication of explicit foreground selection, never background history references.
+
+use super::App;
+use codex_protocol::ThreadId;
+
+enum Selection {
+    Foreground(ThreadId),
+    Detached,
+}
+
+impl App {
+    pub(super) fn publish_client_selection(&mut self) {
+        let selection = match (self.reconnect.offline, self.active_thread_id) {
+            (false, Some(thread_id)) => Selection::Foreground(thread_id),
+            (false, None) | (true, _) => Selection::Detached,
+        };
+        self.update_client_presence(selection);
+    }
+
+    pub(super) fn clear_client_selection(&mut self) {
+        self.update_client_presence(Selection::Detached);
+    }
+
+    fn update_client_presence(&mut self, selection: Selection) {
+        let Some(presence) = self.client_presence.as_mut() else {
+            return;
+        };
+        let result = match selection {
+            Selection::Foreground(thread_id) => presence.select_thread(&thread_id.to_string()),
+            Selection::Detached => presence.clear_selection(),
+        };
+        if let Err(error) = result {
+            self.client_presence = None;
+            tracing::warn!(%error, "TUI client presence disabled after an I/O error");
+        }
+    }
+}
+
+#[cfg(all(test, unix))]
+#[path = "client_presence_tests.rs"]
+mod tests;
diff --git a/codex-rs/tui/src/app/client_presence_tests.rs b/codex-rs/tui/src/app/client_presence_tests.rs
new file mode 100644
index 0000000..1af181d
--- /dev/null
+++ b/codex-rs/tui/src/app/client_presence_tests.rs
@@ -0,0 +1,135 @@
+use super::*;
+use crate::client_presence::ClientPresence;
+use pretty_assertions::assert_eq;
+use serde_json::Value;
+use std::fs;
+use std::fs::Permissions;
+use std::os::unix::fs::PermissionsExt;
+use std::path::Path;
+use tempfile::TempDir;
+use uuid::Uuid;
+
+fn opted_in_home() -> TempDir {
+    let home = tempfile::tempdir().unwrap();
+    fs::set_permissions(home.path(), Permissions::from_mode(0o700)).unwrap();
+    let root = home.path().join("client-presence-v1");
+    fs::create_dir(&root).unwrap();
+    fs::set_permissions(&root, Permissions::from_mode(0o700)).unwrap();
+    fs::write(root.join("ENABLED"), b"version=1\n").unwrap();
+    fs::set_permissions(root.join("ENABLED"), Permissions::from_mode(0o600)).unwrap();
+    home
+}
+
+fn selection(home: &Path) -> Value {
+    let directory = fs::read_dir(home.join("client-presence-v1"))
+        .unwrap()
+        .map(|entry| entry.unwrap().path())
+        .find(|path| path.is_dir())
+        .unwrap();
+    let state: Value =
+        serde_json::from_slice(&fs::read(directory.join("state.json")).unwrap()).unwrap();
+    state["selectedThreadId"].clone()
+}
+
+#[tokio::test]
+async fn foreground_activation_clear_and_offline_do_not_publish_background_threads() {
+    let home = opted_in_home();
+    let mut app = super::super::test_support::make_test_app().await;
+    app.client_presence = ClientPresence::start(home.path()).unwrap();
+    let foreground = ThreadId::from_string(&Uuid::new_v4().to_string()).unwrap();
+    let background = ThreadId::from_string(&Uuid::new_v4().to_string()).unwrap();
+    let mut selections = vec![selection(home.path())];
+
+    app.ensure_thread_channel(foreground);
+    app.activate_thread_channel(foreground).await;
+    selections.push(selection(home.path()));
+    app.ensure_thread_channel(background);
+    app.publish_client_selection();
+    selections.push(selection(home.path()));
+    app.clear_active_thread().await;
+    selections.push(selection(home.path()));
+    app.activate_thread_channel(background).await;
+    selections.push(selection(home.path()));
+    app.reconnect.offline = true;
+    app.publish_client_selection();
+    selections.push(selection(home.path()));
+    app.reconnect.offline = false;
+    app.publish_client_selection();
+    selections.push(selection(home.path()));
+
+    assert_eq!(
+        selections,
+        vec![
+            Value::Null,
+            Value::String(foreground.to_string()),
+            Value::String(foreground.to_string()),
+            Value::Null,
+            Value::String(background.to_string()),
+            Value::Null,
+            Value::String(background.to_string()),
+        ]
+    );
+    assert_eq!(app.active_thread_id, Some(background));
+    drop(app);
+    assert_eq!(
+        fs::read_dir(home.path().join("client-presence-v1"))
+            .unwrap()
+            .count(),
+        1
+    );
+}
+
+#[tokio::test]
+async fn read_only_foreground_is_published_without_changing_ownership() {
+    let home = opted_in_home();
+    let mut app = super::super::test_support::make_test_app().await;
+    app.client_presence = ClientPresence::start(home.path()).unwrap();
+    let foreground = ThreadId::from_string(&Uuid::new_v4().to_string()).unwrap();
+    app.ensure_thread_channel(foreground);
+    app.upsert_agent_picker_thread(
+        foreground, /*agent_nickname*/ None, /*agent_role*/ None, /*is_closed*/ true,
+    );
+    app.agent_navigation.mark_parent_owned(foreground);
+    app.chat_widget.set_parent_owned_thread();
+    app.chat_widget.show_external_writer_thread();
+
+    app.activate_thread_channel(foreground).await;
+
+    assert_eq!(
+        (
+            selection(home.path()),
+            app.chat_widget.is_external_writer_view(),
+            app.agent_navigation.is_parent_owned(foreground),
+            app.active_thread_id,
+        ),
+        (
+            Value::String(foreground.to_string()),
+            true,
+            true,
+            Some(foreground)
+        )
+    );
+}
+
+#[tokio::test]
+async fn publication_error_disables_presence_without_changing_foreground_state() {
+    let home = opted_in_home();
+    let mut app = super::super::test_support::make_test_app().await;
+    app.client_presence = ClientPresence::start(home.path()).unwrap();
+    let foreground = ThreadId::from_string(&Uuid::new_v4().to_string()).unwrap();
+    app.active_thread_id = Some(foreground);
+    fs::rename(
+        home.path().join("client-presence-v1"),
+        home.path().join("retired-presence"),
+    )
+    .unwrap();
+
+    app.publish_client_selection();
+
+    assert_eq!(
+        (app.client_presence.is_none(), app.active_thread_id),
+        (true, Some(foreground))
+    );
+    app.clear_client_selection();
+    assert_eq!(app.active_thread_id, Some(foreground));
+}
