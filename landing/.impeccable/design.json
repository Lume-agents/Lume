      "css": ".ds-text-link{display:inline-flex;align-items:center;gap:18px;padding-bottom:6px;border-bottom:1px solid currentColor;color:var(--ink,#18231b);text-decoration:none;font-family:Manrope,sans-serif;font-size:13px;font-weight:600;}.ds-text-link svg{fill:none;stroke:currentColor;stroke-width:1.5;stroke-linecap:round;stroke-linejoin:round;flex-shrink:0;width:18px;height:18px;transition:transform .3s var(--ease,cubic-bezier(.16,1,.3,1));}.ds-text-link:hover svg{transform:translate(2px,-2px);}.ds-text-link:focus-visible{outline:2px solid var(--focus,#66834c);outline-offset:6px;}@media(prefers-reduced-motion:reduce){.ds-text-link svg{transition:none;}}"
