      "css": ".ds-scroll-link{display:inline-flex;align-items:center;gap:16px;color:var(--ink,#18231b);text-decoration:none;font-family:Manrope,sans-serif;font-size:12px;}.ds-round-arrow{width:46px;height:46px;border:1px solid #a9b39d;border-radius:50%;display:grid;place-items:center;transition:background .3s;}.ds-round-arrow svg{fill:none;stroke:currentColor;stroke-width:1.5;stroke-linecap:round;stroke-linejoin:round;flex-shrink:0;width:18px;height:22px;transform:rotate(90deg);}.ds-scroll-link:hover .ds-round-arrow{background:#d7ddcd;}.ds-scroll-link:focus-visible{outline:2px solid var(--focus,#66834c);outline-offset:6px;}@media(max-width:760px){.ds-scroll-link{font-size:11px;gap:10px;}.ds-round-arrow{width:38px;height:38px;}}@media(max-width:480px){.ds-scroll-link>span:first-child{display:none;}}"
